Screen {
    layout: horizontal;
}

#left {
    width: 32;
    border-right: tall $primary-darken-2;
}

#left.hidden {
    display: none;
}

#sidebar {
    height: 1fr;
    background: transparent;
}

#subline {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#right {
    width: 1fr;
}

#header {
    height: 1;
    padding: 0 1;
    text-style: bold;
    background: $boost;
}

#notice {
    height: auto;
    padding: 0 1;
    color: $warning;
}

#notice.empty {
    display: none;
}

#thread {
    height: 1fr;
}

#thread-scroll {
    height: 1fr;
    padding: 0 1;
}

#thread-new {
    height: 1;
    padding: 0 1;
    text-style: bold;
    color: $text;
    background: $accent;
    display: none;
}

#compose-box {
    height: auto;
    border-top: tall $primary-darken-2;
}

#dm-status, #quote {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#dm-status.empty, #quote.empty {
    display: none;
}

#mentions {
    height: auto;
    max-height: 7;
    border: none;
}

#composer {
    height: auto;
    min-height: 1;
    max-height: 8;
    border: none;
    padding: 0 1;
}

ModalScreen {
    layout: vertical;
    align: center middle;
}

.dialog {
    width: 64;
    max-width: 95%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#info-body {
    height: auto;
    max-height: 60vh;
}

#picker-list, #jump-list {
    height: auto;
    max-height: 14;
}
