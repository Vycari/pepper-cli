{
  "repo": "Vycari/pepper-cli",
  "defaultBranch": "main",
  "language": "python",
  "commands": {
    "format": "uv run ruff format --check",
    "lint": "uv run ruff check",
    "build": null,
    "test": "uv run pytest",
    "coverage": "uv run pytest --cov --cov-report=json:coverage-summary.json",
    "typecheck": "uv run ty check src/pepper_cli/"
  },
  "coverage": {
    "floor": 88
  },
  "paths": {
    "source": "src/pepper_cli/",
    "tests": "tests/",
    "designDocs": ["planning/"],
    "productDocs": [
      "README.md",
      "CLAUDE.md"
    ],
    "changelogDir": null,
    "researchRadarDir": null,
    "prTemplate": ".github/PULL_REQUEST_TEMPLATE.md",
    "skillsDir": ".claude/skills/"
  },
  "guidelines": {
    "coding": ".claude/guidelines/coding.md",
    "testing": ".claude/guidelines/testing.md",
    "invariants": ".claude/guidelines/invariants.md"
  },
  "labels": {
    "architecture": "architecture",
    "testQuality": "test-quality",
    "security": "security",
    "dependencies": "dependencies",
    "automated": "automated"
  },
  "dailyUpdate": {
    "subSkills": [
      "audit-product-docs"
    ],
    "branchPrefix": "daily-update-",
    "commitSubject": "chore(daily): {date} daily update"
  },
  "autoDev": {
    "enabled": false,
    "branchPrefix": "auto/issue-",
    "marker": "<!-- auto-dev -->",
    "stateLabels": {
      "needsInfo": "auto:needs-info",
      "planned": "auto:planned",
      "ready": "auto:ready",
      "inProgress": "auto:in-progress",
      "parked": "auto:parked",
      "skip": "auto:skip"
    },
    "excludedLabels": [
      "epic",
      "question",
      "wontfix",
      "duplicate",
      "invalid"
    ],
    "openPrsAsDraft": false,
    "prLabel": "auto:pr",
    "fallbackReviewMinutes": 60,
    "maxPrsInFlight": 1,
    "orphanReclaimMinutes": 90
  },
  "createPr": {
    "requireIssueForDeferredWork": true
  },
  "review": {
    "bots": [
      "greptile-apps[bot]"
    ],
    "approvalThreshold": "5/5",
    "responderTier": "capable",
    "impasseRounds": 2,
    "sameFileRoundCap": 3
  },
  "release": null
}
